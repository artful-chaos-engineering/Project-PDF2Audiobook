# Language model (used for cleaning and script writing)
# LLM_PROVIDER: anthropic | openai | openrouter | openai_compatible | lmstudio | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
OPENROUTER_API_KEY=your_openrouter_key
OPENAI_COMPATIBLE_API_KEY=your_compatible_key
OPENAI_COMPATIBLE_BASE_URL=https://your-server.example.com/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Voice server
# VOICE_PROVIDER: elevenlabs | heygen
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
HEYGEN_API_KEY=your_heygen_key

# Speech model and delivery tags (optional)
# TTS_MODEL=eleven_multilingual_v2
# AUDIO_TAGS=off
